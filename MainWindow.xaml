<Window x:Class="WPF_HOTEL.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF_HOTEL"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

    <Grid Background="#FFCCF3F2">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,266,0" Background="#FFCCF3F2" >

            <Calendar  x:Name="Calendear1" DisplayDateStart="1/1/2026" 
                      DisplayDateEnd="1/1/2027" Height="133" Width="189"  SelectedDatesChanged="Calendar_SelectedDatesChanged"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.Column="1" Background="#FFCCF3F2">
            <Calendar  x:Name="Calendear2" DisplayDateStart="1/1/2026" 
          DisplayDateEnd="1/1/2027" Height="133" Width="189" SelectedDatesChanged="Calendar_SelectedDatesChanged"/>
        </StackPanel>

        <TextBlock Text="{Binding ElementName=Calendear1, Path=SelectedDate}" FontSize="20" Grid.Column="0" Grid.Row="2"
                   HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
       
        <TextBlock Text="להזמנת חופשה" Grid.Row="0" Grid.Column="2" FontWeight="Bold" FontSize="22" HorizontalAlignment="Center" 
                   VerticalAlignment="Center" />
        <TextBlock Text="בחר תאריך לחופשה" Grid.Row="0" Grid.Column="0" FontWeight="Bold" FontSize="22" HorizontalAlignment="Center" 
           VerticalAlignment="Center" />
        <TextBlock Text="בחר תאריך סיום לחופשה" Grid.Row="0" Grid.Column="1" FontWeight="Bold" FontSize="22" HorizontalAlignment="Center" 
   VerticalAlignment="Center" />
        <TextBlock Grid.Column="2" Grid.Row="1" Text="בחירת עיר" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" />

        <ComboBox x:Name="City" Width="200" Height="29" Grid.Row="1" Grid.Column="2" VerticalAlignment="Top" Margin="34,22,33,0" SelectionChanged="City_SelectionChanged">
            <ComboBox.Background>
                <LinearGradientBrush EndPoint="0,1">
                    <GradientStop Color="#FFF0F0F0"/>
                    <GradientStop Color="#FFCCF3F2" Offset="1"/>
                </LinearGradientBrush>
            </ComboBox.Background>
            <ComboBoxItem Content="ירושלים"/>
            <ComboBoxItem Content="תל אביב"/>
            <ComboBoxItem Content="הרצליה"/>
        </ComboBox>
        <TextBlock Grid.Column="2" Grid.Row="1" Text="בחירת מלון" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" 
                   VerticalAlignment="Center"/>
        <ComboBox x:Name="Hotel" Width="200" Height="31" Grid.Row="1" Grid.Column="2" VerticalAlignment="Top" Margin="34,87,33,0" SelectionChanged="Hotel_SelectionChanged">
            <ComboBoxItem Content="קינג ג'ורג'"/>
            <ComboBoxItem Content="סטאי"/>
            <ComboBoxItem Content="דניאל"/>
        </ComboBox>
        <TextBlock x:Name="NightsText"
           Text="מספר לילות: 0"
           FontSize="20"
           FontWeight="Bold"
           Grid.Row="2"
           Grid.Column="2"
           HorizontalAlignment="Center"
           VerticalAlignment="Top"
           Margin="0,10,0,0"/>

        <TextBlock x:Name="PriceText"
           Text="₪ סכום לתשלום: 0 "
           FontSize="20"
           FontWeight="Bold"
           Grid.Row="2"
           Grid.Column="2"
           HorizontalAlignment="Center"
           VerticalAlignment="Top"
           Margin="0,50,0,0"/>

        <StackPanel Grid.Row="2" Grid.Column="1"
            HorizontalAlignment="Center" VerticalAlignment="Center" Height="125">


            <TextBlock Text="בחר סוג חדר"
               FontSize="18"
               FontWeight="Bold"
               HorizontalAlignment="Center" VerticalAlignment="Top"/>


            <RadioButton x:Name="Single"
                 Content="חדר יחיד"
                 GroupName="RoomType"
                 Margin="5"
                 Checked="RoomType_Checked"/>

            <RadioButton x:Name="Double"
                 Content="חדר זוגי"
                 GroupName="RoomType"
                         
                 Margin="5"
                 Checked="RoomType_Checked"/>

            <RadioButton x:Name="Triple"
                 Content="חדר טריפל"
                 GroupName="RoomType"
                 Margin="5"
                 Checked="RoomType_Checked"/>

            <RadioButton x:Name="Quad"
                 Content="חדר לארבעה"
                 GroupName="RoomType"
                 Margin="5"
                 Checked="RoomType_Checked"/>
        </StackPanel>












    </Grid>
</Window>
